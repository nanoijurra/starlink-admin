{
  "name": "Starlink ACC",
  "short_name": "Starlink ACC",
  "description": "Administracion compartida de pagos Starlink ACC.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f5f7f6",
  "theme_color": "#126c59",
  "share_target": {
    "action": "./share-target.html",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "comprobante",
          "accept": [
            "image/jpeg",
            "image/png",
            "image/webp",
            "application/pdf"
          ]
        }
      ]
    }
  }
}
